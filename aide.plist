<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.aide</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/aide</string>
        <string>--config</string>
        <string>__HOME__/.aide/config.yaml</string>
        <string>--db</string>
        <string>__HOME__/.aide/aide.db</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/aide.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/aide.err</string>
</dict>
</plist>
