services:
  aide:
    image: ghcr.io/sfakam/aide:latest
    build:
      context: {{ build_context }}
      args:
        UID: {{ uid }}
        GID: {{ gid }}
    restart: unless-stopped

    volumes:
      # ── Required (always mounted) ────────────────────────────────────────────
      - {{ home }}/.aide:/home/aide/.aide:rw
      - {{ home }}/.claude:/home/aide/.claude:ro
      - {{ home }}/.local/share/claude:/home/aide/.local/share/claude:ro
      {% if extra_volumes %}
      # ── Extra (from docker.volumes in config.yaml) ───────────────────────────
      {% for v in extra_volumes %}
      - {{ v }}
      {% endfor %}
      {% endif %}

    environment:
      HOME: /home/aide

    ports:
      - "127.0.0.1:8080:8080"

    cap_drop:
      - ALL

    security_opt:
      - no-new-privileges:true
